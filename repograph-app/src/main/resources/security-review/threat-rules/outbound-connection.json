    "whitelistChecked": true
  },
  {
    "ruleId": "outbound-app-connect",
    "kind": "VIOLATION_OUTBOUND",
    "severity": "HIGH",
    "pattern": "(?i)outbound connection to ([0-9]{1,3}(?:\\.[0-9]{1,3}){3})",
    "group": 1,
    "timePattern": "^([A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})",
    "detailTemplate": "违规外联（应用记录）：目标 {1} 不在允许列表",
